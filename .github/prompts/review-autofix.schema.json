{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "findings", "tests"],
  "properties": {
    "summary": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "status", "explanation"],
        "properties": {
          "key": {"type": "string"},
          "status": {"type": "string", "enum": ["fixed", "not_valid", "already_addressed", "needs_human"]},
          "explanation": {"type": "string"}
        }
      }
    },
    "tests": {
      "type": "array",
      "description": "Literal repository-relative test file paths, optionally with pytest ::node selectors. Put outcomes, timeouts and verification limits in summary or finding explanations, never in this list.",
      "items": {"type": "string", "pattern": "^[^\\s:]+(?:::[^\\s:\\[\\]]+)*(?:\\[[^\\r\\n]*\\])?$"}
    }
  }
}
