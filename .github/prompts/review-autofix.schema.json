{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "findings",
    "tests",
    "customer_impact"
  ],
  "properties": {
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "status",
          "explanation"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "fixed",
              "not_valid",
              "already_addressed",
              "needs_human"
            ]
          },
          "explanation": {
            "type": "string"
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "description": "Literal repository-relative test file paths, optionally with pytest ::node selectors. Put outcomes, timeouts and verification limits in summary or finding explanations, never in this list.",
      "items": {
        "type": "string",
        "pattern": "^[^\\s:]+(?:::[^\\s:\\[\\]]+)*(?:\\[[^\\r\\n]*\\])?$"
      }
    },
    "customer_impact": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "head_sha",
            "entries"
          ],
          "properties": {
            "head_sha": {
              "type": "string"
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "assessment"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "assessment": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
